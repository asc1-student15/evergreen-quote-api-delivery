# CONFIG: SERVICE_NAME (Day 2 - the sponsor announces the official name Monday).
SERVICE_NAME=CHANGEME - set the service name in .env
# Where the API finds its database. On your VM the default is right; in other
# environments (a container, a cluster) the platform injects a different value
# under this same name.
MONGODB_URI=mongodb://127.0.0.1:27017/evergreen
